# =========================================================
# ČEPS – scraper systémové odchylky ČR (RT feed, 1min rozlišení)
# Cookies se cachují na disk → Playwright se spouští jen při expiraci.
# Ukládá do SQLite.
# =========================================================
import json
import sqlite3
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

import pandas as pd
import requests

BASE = "https://www.ceps.cz/cs/data"

PARAMS = {
    "do": "loadGraphData",
    "method": "AktualniSystemovaOdchylkaCR",
    "graph_id": "1040",
    "date_type": "day",
    "interval": "false",
    "version": "RT",
    "function": "AVG",
    "download": "false",
}

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/148.0.0.0 Safari/537.36 Edg/148.0.0.0"
    ),
    "Accept": "application/json, text/javascript, */*; q=0.01",
    "Accept-Language": "cs,en;q=0.9",
    "Referer": BASE,
    "Cache-Control": "no-cache",
    "Pragma": "no-cache",
    "X-Requested-With": "XMLHttpRequest",
}

TZ = ZoneInfo("Europe/Prague")
TIMEOUT = 15

DB_PATH = Path(__file__).parent / "data" / "ceps_odchylka.db"
COOKIE_CACHE = Path(__file__).parent / "data" / "ceps_cookies.json"


# ---------- COOKIE CACHE ----------
def _save_cookies(cookies: dict) -> None:
    COOKIE_CACHE.parent.mkdir(parents=True, exist_ok=True)
    COOKIE_CACHE.write_text(json.dumps(cookies))


def _load_cookies() -> dict | None:
    if COOKIE_CACHE.exists():
        try:
            return json.loads(COOKIE_CACHE.read_text())
        except Exception:
            return None
    return None


# ---------- PLAYWRIGHT (jen při expiraci) ----------
def _get_cookies_via_browser() -> dict:
    """Spustí headless Chromium a získá čerstvé session cookies."""
    from playwright.sync_api import sync_playwright
    with sync_playwright() as p:
        browser = p.chromium.launch(headless=True)
        ctx = browser.new_context(user_agent=HEADERS["User-Agent"])
        ctx.add_cookies([{
            "name": "cc_cookie",
            "value": json.dumps({
                "level": ["necessary", "analytics"],
                "revision": 0,
                "data": None,
                "rfc_cookie": False,
            }),
            "domain": "www.ceps.cz",
            "path": "/",
        }])
        page = ctx.new_page()
        page.goto(BASE, wait_until="networkidle", timeout=30_000)
        cookies = {c["name"]: c["value"] for c in ctx.cookies()}
        browser.close()
    _save_cookies(cookies)
    return cookies


def _build_session(cookies: dict) -> requests.Session:
    s = requests.Session()
    for name, value in cookies.items():
        s.cookies.set(name, value)
    return s


_session: requests.Session | None = None


def _get_session() -> requests.Session:
    global _session
    if _session is None:
        # Zkus načíst z cache, jinak spusť Playwright
        cookies = _load_cookies()
        if cookies:
            _session = _build_session(cookies)
        else:
            _session = _build_session(_get_cookies_via_browser())
    return _session


# ---------- SCRAPER ----------
def fetch_raw() -> dict:
    """Stáhne JSON z ČEPS RT feedu. Playwright spustí jen při expiraci session."""
    global _session
    for attempt in range(2):
        s = _get_session()
        r = s.get(BASE, headers=HEADERS, params=PARAMS, timeout=TIMEOUT)
        r.raise_for_status()
        data = r.json()
        if isinstance(data, dict) and "redirect" in data:
            # Cookies expirovala → smaž cache, spusť Playwright
            COOKIE_CACHE.unlink(missing_ok=True)
            _session = _build_session(_get_cookies_via_browser())
            if attempt == 1:
                raise RuntimeError("Session refresh přes Playwright selhal.")
            continue
        return data
    raise RuntimeError("fetch_raw: neočekávaný stav")


# ---------- PARSER ----------
def parse_points(raw: dict) -> pd.DataFrame:
    cfg = raw["result"]
    if isinstance(cfg, str):
        cfg = json.loads(cfg)
    data = cfg["chart"]["series"][0]["data"]
    rows = []
    for p in data:
        cas = datetime.strptime(p["x"], "%d.%m.%Y %H:%M").replace(tzinfo=TZ)
        rows.append((cas, float(p["value"])))
    df = pd.DataFrame(rows, columns=["cas", "odchylka_mw"])
    df = (
        df.dropna()
        .drop_duplicates("cas")
        .sort_values("cas")
        .reset_index(drop=True)
    )
    df["held"] = df["odchylka_mw"].round(4).eq(df["odchylka_mw"].round(4).shift())
    return df


def get_odchylka() -> pd.DataFrame:
    return parse_points(fetch_raw())


# ---------- SQLITE ----------
@contextmanager
def _db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    try:
        yield conn
        conn.commit()
    finally:
        conn.close()


def init_db() -> None:
    with _db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS ceps_odchylka (
                cas         TEXT PRIMARY KEY,
                odchylka_mw REAL    NOT NULL,
                held        INTEGER NOT NULL DEFAULT 0
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_cas ON ceps_odchylka (cas)")


def store(df: pd.DataFrame) -> int:
    records = [
        (row.cas.isoformat(), row.odchylka_mw, int(row.held))
        for row in df.itertuples()
    ]
    with _db() as conn:
        cursor = conn.executemany(
            "INSERT OR IGNORE INTO ceps_odchylka (cas, odchylka_mw, held) VALUES (?, ?, ?)",
            records,
        )
    return cursor.rowcount


def fetch_db(limit: int = 1440) -> pd.DataFrame:
    with _db() as conn:
        df = pd.read_sql(
            f"SELECT * FROM ceps_odchylka ORDER BY cas DESC LIMIT {limit}",
            conn,
            parse_dates=["cas"],
        )
    return df.sort_values("cas").reset_index(drop=True)


def sync() -> int:
    """Stáhne aktuální den a uloží nové body. Vrátí počet nových řádků."""
    init_db()
    df = get_odchylka()
    return store(df)


# ---------- SPUŠTĚNÍ ----------
if __name__ == "__main__":
    cookie_source = "cache" if _load_cookies() else "Playwright"
    print(f"Session: {cookie_source}")
    init_db()
    df = get_odchylka()
    new = store(df)
    ted = datetime.now(TZ)
    delay = (ted - df.iloc[-1]["cas"]).total_seconds() / 60
    print(f"Řádků: {len(df)} | nových v DB: {new}")
    print(f"Rozsah: {df['cas'].min():%H:%M} – {df['cas'].max():%H:%M}")
    print(f"Poslední bod: {df.iloc[-1]['cas']:%Y-%m-%d %H:%M} = {df.iloc[-1]['odchylka_mw']:.1f} MW")
    print(f"Delay feedu:  {delay:.1f} min")
