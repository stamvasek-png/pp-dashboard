    'ARRAffinitySameSite=02b183f3e187238eddb9a3a48d79f48c7f8be131e432ce5a87452254fcb0bcab; '
    '_ga_GB5X4KHL3C=GS2.1.s1780901355$o34$g1$t1780901392$j42$l0$h0'
)

PARAMS = {
    "do": "loadGraphData",
    "method": "AktualniSystemovaOdchylkaCR",
    "graph_id": "1040",
    "date_type": "day",
    "interval": "false",
