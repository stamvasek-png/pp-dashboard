    "Pragma": "no-cache",
    "X-Requested-With": "XMLHttpRequest",     # nutné pro Nette AJAX
}
if COOKIE:
    HEADERS["Cookie"] = COOKIE

TZ = ZoneInfo("Europe/Prague")
TIMEOUT = 15
_session = requests.Session()


# ---------- SCRAPER ----------
def fetch_raw():
    """Stáhne JSON z ČEPS. Hodí výjimku, když přijde redirect (vypršelá session)."""
    r = _session.get(BASE, headers=HEADERS, params=PARAMS, timeout=TIMEOUT)
    r.raise_for_status()
    data = r.json()
    if isinstance(data, dict) and "redirect" in data:
        raise RuntimeError(
            "Redirect = vypršela session. Zkopíruj z DevTools nový řádek "
            "'cookie:' (hlavně PHPSESSID + ARRAffinity) a nahraď COOKIE výše."
        )
    return data


# ---------- PARSER ----------
def parse_points(raw):
    """AnyChart config -> DataFrame [cas, odchylka_mw, held].
    held=True = ČEPS opakuje poslední hodnotu (forward-fill, ne reálné měření)."""
    cfg = raw["result"]
    if isinstance(cfg, str):
        cfg = json.loads(cfg)
    data = cfg["chart"]["series"][0]["data"]
    rows = []
    for p in data:
        cas = datetime.strptime(p["x"], "%d.%m.%Y %H:%M").replace(tzinfo=TZ)
        rows.append((cas, float(p["value"])))
    df = pd.DataFrame(rows, columns=["cas", "odchylka_mw"])
    df = (df.dropna()
            .drop_duplicates("cas")
            .sort_values("cas")
            .reset_index(drop=True))
    df["held"] = df["odchylka_mw"].round(4).eq(df["odchylka_mw"].round(4).shift())
    return df


def get_odchylka():
    """Stáhne + vyparsuje aktuální systémovou odchylku. Vrací DataFrame."""
    return parse_points(fetch_raw())


# ---------- POLLING DO CSV (volitelné) ----------
def poll(output_csv="ceps_odchylka.csv", interval_sec=30, max_minutes=120):
    """Dotahuje data v intervalu, dedupuje podle času, appenduje do CSV.
    Pro Drive: output_csv='/content/drive/MyDrive/ceps_odchylka.csv' (+ drive.mount)."""
    try:
        hist = pd.read_csv(output_csv, parse_dates=["cas"])
        seen = set(hist["cas"].astype(str))
        print(f"Načteno {len(hist)} existujících řádků.")
    except FileNotFoundError:
        seen = set()
        print("Začínám nový soubor.")
    print(f"Polling {interval_sec}s, max {max_minutes} min. Stop tlačítkem.\n")
    t_end = time.time() + max_minutes * 60
    while time.time() < t_end:
        try:
            new = get_odchylka()
            new = new[~new["cas"].astype(str).isin(seen)]
            if not new.empty:
                new.to_csv(output_csv, mode="a", header=not seen, index=False)
                seen.update(new["cas"].astype(str))
                r = new.iloc[-1]
                print(f"[{datetime.now(TZ):%H:%M:%S}] +{len(new)} nových, "
                      f"poslední {r['cas']:%H:%M:%S} = {r['odchylka_mw']:.1f} MW", flush=True)
            else:
                print(f"[{datetime.now(TZ):%H:%M:%S}] beze změny", flush=True)
        except Exception as e:
            print(f"[CHYBA] {type(e).__name__}: {e}", flush=True)
        time.sleep(interval_sec)
    print("\nHotovo.")


# ---------- SPUŠTĚNÍ ----------
df = get_odchylka()
ted = datetime.now(TZ)
delay = (ted - df.iloc[-1]["cas"]).total_seconds() / 60
print(f"Řádků: {len(df)}  | rozsah: {df['cas'].min():%H:%M} – {df['cas'].max():%H:%M}")
print(f"Forward-fill (held=True): {int(df['held'].sum())}")
print(f"Poslední bod: {df.iloc[-1]['cas']:%Y-%m-%d %H:%M} = {df.iloc[-1]['odchylka_mw']:.1f} MW")
print(f"Delay feedu:  {delay:.1f} min (teď {ted:%H:%M:%S})")
df.tail(10)
