# =========================================================
# ČEPS – scraper systémové odchylky ČR (RT feed, 1min rozlišení)
# Ukládá do SQLite. Session cookies se obnovují automaticky.
# =========================================================
import json
import sqlite3
from contextlib import contextmanager
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

import pandas as pd
import requests

# ---------- KONFIGURACE ----------
BASE = "https://www.ceps.cz/cs/data"

PARAMS = {
    "do": "loadGraphData",
    "method": "AktualniSystemovaOdchylkaCR",
    "graph_id": "1040",
    "date_type": "day",
    "interval": "false",
    "version": "RT",
    "function": "AVG",
    "download": "false",
}

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/148.0.0.0 Safari/537.36 Edg/148.0.0.0"
    ),
    "Accept": "application/json, text/javascript, */*; q=0.01",
    "Accept-Language": "cs,en;q=0.9",
    "Referer": "https://www.ceps.cz/cs/data",
    "Cache-Control": "no-cache",
    "Pragma": "no-cache",
    "X-Requested-With": "XMLHttpRequest",
}

TZ = ZoneInfo("Europe/Prague")
TIMEOUT = 15

DB_PATH = Path(__file__).parent / "data" / "ceps_odchylka.db"


# ---------- SESSION (auto-refresh) ----------
def _new_session() -> requests.Session:
    """Navštíví ČEPS homepage a získá čerstvé PHPSESSID + ARRAffinity cookies."""
    s = requests.Session()
    s.get(BASE, headers={"User-Agent": HEADERS["User-Agent"]}, timeout=TIMEOUT)
    return s


_session: requests.Session | None = None


def _get_session() -> requests.Session:
    global _session
    if _session is None:
        _session = _new_session()
    return _session


# ---------- SCRAPER ----------
def fetch_raw() -> dict:
    """Stáhne JSON z ČEPS. Při expirované session ji automaticky obnoví."""
    global _session
    for attempt in range(2):
        s = _get_session()
        r = s.get(BASE, headers=HEADERS, params=PARAMS, timeout=TIMEOUT)
        r.raise_for_status()
        data = r.json()
        if isinstance(data, dict) and "redirect" in data:
            # Session vypršela → refresh a opakuj (max 1×)
            _session = _new_session()
            if attempt == 1:
                raise RuntimeError("Session refresh selhal, ČEPS blokuje.")
            continue
        return data
    raise RuntimeError("fetch_raw: neočekávaný stav")


# ---------- PARSER ----------
def parse_points(raw: dict) -> pd.DataFrame:
    """AnyChart config → DataFrame [cas, odchylka_mw, held]."""
    cfg = raw["result"]
    if isinstance(cfg, str):
        cfg = json.loads(cfg)
    data = cfg["chart"]["series"][0]["data"]
    rows = []
    for p in data:
        cas = datetime.strptime(p["x"], "%d.%m.%Y %H:%M").replace(tzinfo=TZ)
        rows.append((cas, float(p["value"])))
    df = pd.DataFrame(rows, columns=["cas", "odchylka_mw"])
    df = (
        df.dropna()
        .drop_duplicates("cas")
        .sort_values("cas")
        .reset_index(drop=True)
    )
    df["held"] = df["odchylka_mw"].round(4).eq(df["odchylka_mw"].round(4).shift())
    return df


def get_odchylka() -> pd.DataFrame:
    """Stáhne + vyparsuje aktuální systémovou odchylku. Vrací DataFrame."""
    return parse_points(fetch_raw())


# ---------- SQLITE ----------
@contextmanager
def _db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.execute("PRAGMA journal_mode=WAL")
    try:
        yield conn
        conn.commit()
    finally:
        conn.close()


def init_db() -> None:
    """Vytvoří tabulku pokud neexistuje."""
    with _db() as conn:
        conn.execute("""
            CREATE TABLE IF NOT EXISTS ceps_odchylka (
                cas       TEXT PRIMARY KEY,
                odchylka_mw REAL NOT NULL,
                held      INTEGER NOT NULL DEFAULT 0
            )
        """)
        conn.execute("CREATE INDEX IF NOT EXISTS idx_cas ON ceps_odchylka (cas)")


def store(df: pd.DataFrame) -> int:
    """Uloží DataFrame do DB, přeskočí duplikáty. Vrátí počet nových řádků."""
    records = [
        (row.cas.isoformat(), row.odchylka_mw, int(row.held))
        for row in df.itertuples()
    ]
    with _db() as conn:
        cursor = conn.executemany(
            "INSERT OR IGNORE INTO ceps_odchylka (cas, odchylka_mw, held) VALUES (?, ?, ?)",
            records,
        )
    return cursor.rowcount


def fetch_db(limit: int = 1440) -> pd.DataFrame:
    """Načte posledních N řádků z DB (výchozí = 1 den)."""
    with _db() as conn:
        df = pd.read_sql(
            f"SELECT * FROM ceps_odchylka ORDER BY cas DESC LIMIT {limit}",
            conn,
            parse_dates=["cas"],
        )
    return df.sort_values("cas").reset_index(drop=True)


# ---------- JEDNORÁZOVÝ SYNC (pro cron) ----------
def sync() -> int:
    """Stáhne aktuální den a uloží nové body. Vrátí počet nových řádků."""
    init_db()
    df = get_odchylka()
    new = store(df)
    return new


# ---------- SPUŠTĚNÍ (test) ----------
if __name__ == "__main__":
    init_db()
    df = get_odchylka()
    new = store(df)
    ted = datetime.now(TZ)
    delay = (ted - df.iloc[-1]["cas"]).total_seconds() / 60
    print(f"Řádků: {len(df)} | nových v DB: {new}")
    print(f"Rozsah: {df['cas'].min():%H:%M} – {df['cas'].max():%H:%M}")
    print(f"Poslední bod: {df.iloc[-1]['cas']:%Y-%m-%d %H:%M} = {df.iloc[-1]['odchylka_mw']:.1f} MW")
    print(f"Delay feedu: {delay:.1f} min")
    print(f"DB: {DB_PATH}")
